# Copy this file to ".env" and fill in your own values. Never share or submit the .env file.

# Your name (shown on the dashboard, keep it the same every time) and your Trainer Central email
MY_NAME=Your Full Name
MY_EMAIL=you@example.com

# Anthropic API key (from the trainer)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Google Drive: the folder ID is the last part of the folder link
DRIVE_FOLDER_ID=1u616cv0oZK4wK5EcnxPahgkEi0ypjzvU
GOOGLE_API_KEY=

# Dashboard API
DASHBOARD_URL=https://trainer-central-assigments-api.onrender.com
# Only fill this if the trainer says the API needs an x-api-key
DASHBOARD_API_KEY=

# Testing helpers (leave empty / 0 for the real thing)
# LOCAL_FOLDER=C:\path\to\sample\files
DRY_RUN=0
